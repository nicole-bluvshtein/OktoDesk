# Copy to .env (never committed) or set these in your shell. All are optional.

# NVD API key: raises the rate limit from 5 to 50 requests per 30 seconds.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-key-here

# Run against the real NVD service instead of the simulated data (same as main.py --live)
OKTODESK_LIVE=false

# Tuning (defaults shown)
OKTODESK_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
OKTODESK_NVD_TIMEOUT=10
OKTODESK_NVD_ATTEMPTS=3
OKTODESK_NVD_RETRY_WAIT=2
OKTODESK_NVD_LOOKBACK_DAYS=90
OKTODESK_NVD_RESULTS_PER_PAGE=20
